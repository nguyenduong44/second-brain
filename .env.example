# second-brain — copy sang .env, điền giá trị thật. KHÔNG commit .env.
# OMNIROUTE_API_KEY lấy từ ~/.secrets trên máy của bạn, không paste vào chat.
PORT=4000
JWT_SECRET=<thay-bang-chuoi-dai-hon-32-ky-tu>
ADMIN_PASSWORD=<mat-khau-dang-nhap-web-cua-ban>

# OmniRoute chạy ở cổng 20228 (20229 chết, đừng dùng).
# Local: localhost:20228; trong Docker
# server dùng host.docker.internal:20228 (xem docker-compose.yml).
OMNIROUTE_BASE_URL=http://localhost:20228/v1
OMNIROUTE_API_KEY=<lay-tu-~/.secrets>

# Phân luồng model theo tác vụ — đây là routing rule của OmniRoute,
# KHÔNG phải tên model gốc. Đừng đổi thành tên model gốc
# (OmniRoute sẽ báo model not found).
FAST_MODEL=omniroute/auto
CHAT_MODEL=omniroute/auto/coding
VISION_MODEL=omniroute/auto

# Voice microservice (apps/voice). Local: localhost:8000; Docker: voice:8000.
VOICE_SERVICE_URL=http://localhost:8000
WHISPER_MODEL=small
TTS_VOICE=vi-VN-HoaiMyNeural

# Repo root chứa wiki/ + raw-sources/. Chạy local thì để trống (tự tìm từ code).
# Chạy Docker thì set BRAIN_ROOT=/second-brain (xem docker-compose.yml).
BRAIN_ROOT=
